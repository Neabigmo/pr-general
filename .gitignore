# Python and local environments
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env

# Local raw sources and generated build cache never enter the repository.
data/cache/sources/
data/cache/build/
data/cache/tools/
data/cache/**/*.part

# Temporary pipeline files
*.part
data/downloads/
**/mmseqs_work/

# Release outputs are tracked only when they are small metadata/templates.
releases/**/forms/*.jsonl
releases/**/submission/predictions.*
